{
	"name": "mac-location",
	"version": "0.0.0-semantic-release",
	"description": "Get the current location of the Mac from Node.js. Bundled native helper, no API key or network service.",
	"license": "MIT",
	"repository": "privatenumber/mac-location",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"publishConfig": {
		"executableFiles": [
			"./dist-native/mac-location.app/Contents/MacOS/mac-location"
		]
	},
	"files": [
		"dist",
		"dist-native",
		"src-native",
		"skills",
		"docs"
	],
	"type": "module",
	"bin": "./dist/cli.mjs",
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"build": "pkgroll && pnpm build:helper",
		"build:helper": "node scripts/build-helper.ts",
		"verify-helper": "node scripts/verify-helper.ts",
		"cli": "node src/cli.ts",
		"lint": "lintroll --cache --git",
		"test": "node tests/index.ts",
		"type-check": "tsc",
		"benchmark:preparation": "node bench/preparation.ts",
		"benchmark:end-to-end": "node bench/end-to-end.ts",
		"prepack": "pnpm build && pnpm verify-helper && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"cleye": "3.0.0-beta.2"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"clean-pkg-json": "^2.0.0",
		"fs-fixture": "^2.16.0",
		"lintroll": "^1.30.2",
		"manten": "^2.0.1",
		"mitata": "1.0.34",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.27.1",
		"semantic-release": "25.0.9",
		"skills-npm": "^1.2.0",
		"typescript": "^6.0.3"
	}
}
